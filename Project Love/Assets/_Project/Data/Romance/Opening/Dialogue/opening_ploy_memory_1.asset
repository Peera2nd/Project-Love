  m_Name: opening_ploy_memory_1
  m_EditorClassIdentifier: ProjectLove.Runtime::ProjectLove.Data.DialogueNodeSO
  id: opening_ploy_memory_1
  displayName: "\u0E1E\u0E25\u0E2D\u0E22 \xB7 \u0E08\u0E33\u0E04\u0E33\u0E15\u0E2D\u0E1A\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13\u0E44\u0E14\u0E49"
  lines:
  - lineId: opening_ploy_memory_1_line_0
    speaker: {fileID: 11400000, guid: 08140245bb9f0c54b8e6fd5c6e3d6ecf, type: 2}
    expression: 1
    text: "\u0E09\u0E31\u0E19\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E0A\u0E48\u0E27\u0E07\u0E43\u0E2B\u0E49\u0E15\u0E31\u0E27\u0E25\u0E30\u0E04\u0E23\u0E40\u0E25\u0E48\u0E32\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E07\u0E41\u0E25\u0E49\u0E27
      \u0E44\u0E21\u0E48\u0E07\u0E31\u0E49\u0E19\u0E40\u0E2D\u0E32\u0E41\u0E15\u0E48\u0E16\u0E32\u0E21\u0E04\u0E19\u0E40\u0E25\u0E48\u0E19
      \u0E01\u0E47\u0E44\u0E21\u0E48\u0E22\u0E38\u0E15\u0E34\u0E18\u0E23\u0E23\u0E21\u0E40\u0E19\u0E2D\u0E30"
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_ploy_memory_1/line/opening_ploy_memory_1_line_0
  - lineId: opening_ploy_memory_1_line_1
    speaker: {fileID: 11400000, guid: 08140245bb9f0c54b8e6fd5c6e3d6ecf, type: 2}
    expression: 0
    text: "\u0E21\u0E32\u0E40\u0E25\u0E48\u0E19\u0E09\u0E32\u0E01\u0E17\u0E35\u0E48\u0E41\u0E01\u0E49\u0E41\u0E25\u0E49\u0E27\u0E01\u0E31\u0E19\u0E2D\u0E35\u0E01\u0E44\u0E2B\u0E21
      \u0E08\u0E1A\u0E41\u0E25\u0E49\u0E27\u0E25\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E04\u0E33\u0E16\u0E32\u0E21\u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19\u0E15\u0E48\u0E2D
      \u0E04\u0E23\u0E32\u0E27\u0E19\u0E35\u0E49\u0E09\u0E31\u0E19\u0E15\u0E2D\u0E1A\u0E14\u0E49\u0E27\u0E22
      \u0E44\u0E21\u0E48\u0E21\u0E35\u0E2A\u0E34\u0E17\u0E18\u0E34\u0E4C\u0E04\u0E19\u0E2D\u0E2D\u0E01\u0E41\u0E1A\u0E1A"
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_ploy_memory_1/line/opening_ploy_memory_1_line_1
  - lineId: opening_ploy_memory_1_line_2
    speaker: {fileID: 11400000, guid: 08140245bb9f0c54b8e6fd5c6e3d6ecf, type: 2}
    expression: 0
    text: "\u0E1A\u0E48\u0E32\u0E22\u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E22\u0E47\u0E19
      \u0E27\u0E31\u0E19\u0E17\u0E35\u0E48 3 \u0E16\u0E36\u0E07\u0E27\u0E31\u0E19\u0E17\u0E35\u0E48
      7 \u0E40\u0E25\u0E37\u0E2D\u0E01\u0E0A\u0E48\u0E27\u0E07\u0E17\u0E35\u0E48\u0E2A\u0E30\u0E14\u0E27\u0E01\u0E44\u0E14\u0E49\u0E40\u0E25\u0E22
      \u0E40\u0E25\u0E48\u0E19\u0E14\u0E49\u0E27\u0E22\u0E01\u0E31\u0E19\u0E2B\u0E19\u0E36\u0E48\u0E07\u0E0A\u0E48\u0E27\u0E07\u0E19\u0E30"
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_ploy_memory_1/line/opening_ploy_memory_1_line_2
