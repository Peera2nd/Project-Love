  - choiceId: opening_plaifah_personal_1
    text: "\u0E23\u0E32\u0E22\u0E01\u0E32\u0E23\u0E25\u0E30\u0E40\u0E2D\u0E35\u0E22\u0E14\u0E14\u0E35
