  m_Script: {fileID: 11500000, guid: 68294642b7394931b38b71feca2638e1, type: 3}
  m_Name: opening_plaifah_personal
  m_EditorClassIdentifier: ProjectLove.Runtime::ProjectLove.Data.DialogueNodeSO
  id: opening_plaifah_personal
  displayName: "\u0E1B\u0E25\u0E32\u0E22\u0E1F\u0E49\u0E32 \xB7 \u0E04\u0E33\u0E0A\u0E27\u0E19\u0E17\u0E35\u0E48\u0E21\u0E35\u0E2B\u0E31\u0E27\u0E02\u0E49\u0E2D"
  lines:
  - lineId: opening_plaifah_personal_line_0
    speaker: {fileID: 11400000, guid: cfe73e4e73648ac41ba919a55aaeaa37, type: 2}
    expression: 0
    text: "\u0E1F\u0E49\u0E32\u0E01\u0E33\u0E25\u0E31\u0E07\u0E08\u0E30\u0E44\u0E1B\u0E0B\u0E37\u0E49\u0E2D\u0E02\u0E2D\u0E07\u0E27\u0E48\u0E32\u0E07\u0E04\u0E48\u0E30
      \u0E19\u0E35\u0E48... \u0E23\u0E32\u0E22\u0E01\u0E32\u0E23\u0E17\u0E35\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E0A\u0E27\u0E19\u0E44\u0E1B\u0E14\u0E39\u0E14\u0E49\u0E27\u0E22\u0E01\u0E31\u0E19"
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_plaifah_personal/line/opening_plaifah_personal_line_0
  - lineId: opening_plaifah_personal_line_1
    speaker: {fileID: 11400000, guid: cfe73e4e73648ac41ba919a55aaeaa37, type: 2}
    expression: 0
    text: "\u0E27\u0E31\u0E15\u0E16\u0E38\u0E1B\u0E23\u0E30\u0E2A\u0E07\u0E04\u0E4C:
      \u0E40\u0E25\u0E37\u0E2D\u0E01\u0E02\u0E2D\u0E07\u0E27\u0E48\u0E32\u0E07 \u0E23\u0E30\u0E22\u0E30\u0E40\u0E27\u0E25\u0E32:
      \u0E2B\u0E19\u0E36\u0E48\u0E07\u0E0A\u0E48\u0E27\u0E07 \u0E1C\u0E39\u0E49\u0E40\u0E02\u0E49\u0E32\u0E23\u0E48\u0E27\u0E21:
      \u0E2A\u0E2D\u0E07\u0E04\u0E19..."
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_plaifah_personal/line/opening_plaifah_personal_line_1
  - lineId: opening_plaifah_personal_line_2
    speaker: {fileID: 11400000, guid: cfe73e4e73648ac41ba919a55aaeaa37, type: 2}
    expression: 0
    text: "\u0E2D\u0E22\u0E48\u0E32\u0E40\u0E1E\u0E34\u0E48\u0E07\u0E2B\u0E31\u0E27\u0E40\u0E23\u0E32\u0E30\u0E19\u0E30\u0E04\u0E30
      \u0E1F\u0E49\u0E32\u0E2A\u0E48\u0E07\u0E1A\u0E23\u0E35\u0E1F\u0E17\u0E38\u0E01\u0E27\u0E31\u0E19
      \u0E41\u0E15\u0E48\u0E44\u0E21\u0E48\u0E04\u0E48\u0E2D\u0E22\u0E44\u0E14\u0E49\u0E0A\u0E27\u0E19\u0E43\u0E04\u0E23\u0E44\u0E1B\u0E44\u0E2B\u0E19\u0E40\u0E2D\u0E07"
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_plaifah_personal/line/opening_plaifah_personal_line_2
  - lineId: opening_plaifah_personal_line_3
    speaker: {fileID: 11400000, guid: cfe73e4e73648ac41ba919a55aaeaa37, type: 2}
    expression: 0
    text: "\u0E16\u0E49\u0E32\u0E1E\u0E34\u0E21\u0E1E\u0E4C\u0E41\u0E04\u0E48\u0E27\u0E48\u0E32
      \u0E44\u0E1B\u0E0B\u0E37\u0E49\u0E2D\u0E02\u0E19\u0E21\u0E01\u0E31\u0E19\u0E44\u0E2B\u0E21
      \u0E21\u0E31\u0E19\u0E08\u0E30\u0E14\u0E39\u0E44\u0E21\u0E48\u0E21\u0E35\u0E40\u0E2B\u0E15\u0E38\u0E1C\u0E25\u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E1B\u0E25\u0E48\u0E32\u0E04\u0E30"
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_plaifah_personal/line/opening_plaifah_personal_line_3
  choices:
  - choiceId: opening_plaifah_personal_0
    text: "\u0E40\u0E23\u0E35\u0E22\u0E01\u0E27\u0E48\u0E32\u0E0A\u0E27\u0E19\u0E01\u0E31\u0E19\u0E01\u0E47\u0E1E\u0E2D
      \u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E21\u0E35\u0E2B\u0E31\u0E27\u0E02\u0E49\u0E2D\u0E01\u0E47\u0E44\u0E14\u0E49"
    localizedText:
