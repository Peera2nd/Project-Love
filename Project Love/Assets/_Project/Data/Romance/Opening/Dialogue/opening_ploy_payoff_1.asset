  id: opening_ploy_payoff_1
  displayName: "\u0E1E\u0E25\u0E2D\u0E22 \xB7 \u0E04\u0E33\u0E15\u0E2D\u0E1A\u0E2A\u0E48\u0E27\u0E19\u0E15\u0E31\u0E27"
