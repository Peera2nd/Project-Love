  - lineId: opening_ploy_payoff_1_line_0
    speaker: {fileID: 11400000, guid: 08140245bb9f0c54b8e6fd5c6e3d6ecf, type: 2}
    expression: 1
    text: "\u0E15\u0E01\u0E25\u0E07 \u0E09\u0E31\u0E19\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E14\u0E49\u0E27\u0E22\u0E27\u0E48\u0E32\u0E08\u0E30\u0E40\u0E08\u0E2D\u0E04\u0E33\u0E16\u0E32\u0E21\u0E2D\u0E30\u0E44\u0E23
