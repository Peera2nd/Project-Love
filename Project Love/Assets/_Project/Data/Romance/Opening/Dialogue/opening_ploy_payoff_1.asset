  - lineId: opening_ploy_payoff_1_line_1
    speaker: {fileID: 11400000, guid: 08140245bb9f0c54b8e6fd5c6e3d6ecf, type: 2}
    expression: 1
    text: "\u0E16\u0E32\u0E21\u0E21\u0E32\u0E40\u0E25\u0E22 \u0E09\u0E31\u0E19\u0E08\u0E30\u0E1E\u0E22\u0E32\u0E22\u0E32\u0E21\u0E44\u0E21\u0E48\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E2D\u0E2D\u0E01\u0E41\u0E1A\u0E1A\u0E40\u0E01\u0E21"
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_ploy_payoff_1/line/opening_ploy_payoff_1_line_1
  - lineId: opening_ploy_payoff_1_line_2
    speaker: {fileID: 0}
    expression: 0
    text: "\u0E09\u0E32\u0E01\u0E17\u0E14\u0E25\u0E2D\u0E07\u0E08\u0E1A\u0E41\u0E25\u0E49\u0E27
