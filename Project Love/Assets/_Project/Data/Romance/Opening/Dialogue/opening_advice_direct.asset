  m_Script: {fileID: 11500000, guid: 68294642b7394931b38b71feca2638e1, type: 3}
  m_Name: opening_advice_direct
  m_EditorClassIdentifier: ProjectLove.Runtime::ProjectLove.Data.DialogueNodeSO
  id: opening_advice_direct
  displayName: "\u0E27\u0E31\u0E19\u0E41\u0E23\u0E01 \xB7 \u0E25\u0E2D\u0E07\u0E1E\u0E39\u0E14\u0E15\u0E23\u0E07\u0E46
    \u0E27\u0E48\u0E32\u0E2D\u0E22\u0E32\u0E01\u0E40\u0E08\u0E2D\u0E01\u0E31\u0E19\u0E2D\u0E35\u0E01"
  lines:
  - lineId: opening_advice_direct_line_0
    speaker: {fileID: 11400000, guid: b36cc8da13aa4914fae3a8b5aac0bf99, type: 2}
    expression: 0
    text: "\u0E07\u0E31\u0E49\u0E19\u0E25\u0E2D\u0E07\u0E27\u0E48\u0E32... \u0E1E\u0E23\u0E38\u0E48\u0E07\u0E19\u0E35\u0E49\u0E2D\u0E22\u0E32\u0E01\u0E40\u0E08\u0E2D\u0E04\u0E38\u0E13\u0E2D\u0E35\u0E01\u0E04\u0E48\u0E30"
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_advice_direct/line/opening_advice_direct_line_0
  - lineId: opening_advice_direct_line_1
    speaker: {fileID: 11400000, guid: 08140245bb9f0c54b8e6fd5c6e3d6ecf, type: 2}
    expression: 0
    text: "\u0E42\u0E2D\u0E49 \u0E04\u0E23\u0E32\u0E27\u0E19\u0E35\u0E49\u0E44\u0E21\u0E48\u0E21\u0E35\u0E04\u0E33\u0E27\u0E48\u0E32\u0E1E\u0E34\u0E08\u0E32\u0E23\u0E13\u0E32\u0E41\u0E25\u0E49\u0E27!"
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_advice_direct/line/opening_advice_direct_line_1
  - lineId: opening_advice_direct_line_2
    speaker: {fileID: 11400000, guid: cfe73e4e73648ac41ba919a55aaeaa37, type: 2}
    expression: 1
    text: "\u0E1F\u0E49\u0E32\u0E27\u0E32\u0E14\u0E43\u0E2B\u0E49\u0E40\u0E02\u0E32\u0E40\u0E07\u0E22\u0E2B\u0E19\u0E49\u0E32\u0E21\u0E2D\u0E07\u0E04\u0E19\u0E1F\u0E31\u0E07\u0E44\u0E14\u0E49\u0E1E\u0E2D\u0E14\u0E35\u0E40\u0E25\u0E22\u0E04\u0E48\u0E30"
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_advice_direct/line/opening_advice_direct_line_2
  - lineId: opening_advice_direct_line_3
    speaker: {fileID: 11400000, guid: b36cc8da13aa4914fae3a8b5aac0bf99, type: 2}
    expression: 0
    text: "\u0E08\u0E14\u0E44\u0E27\u0E49\u0E01\u0E48\u0E2D\u0E19\u0E04\u0E48\u0E30
      \u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E40\u0E2D\u0E32\u0E44\u0E1B\u0E25\u0E2D\u0E07\u0E43\u0E19\u0E09\u0E32\u0E01\u0E08\u0E23\u0E34\u0E07"
    localizedText:
      catalog: {fileID: 11400000, guid: e731156c4ab4e8e4cbcedb5dda6abf6a, type: 2}
      key: dialogue/opening_advice_direct/line/opening_advice_direct_line_3
  choices: []
