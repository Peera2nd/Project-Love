  presentation: {fileID: 11400000, guid: 650c081cf56dbbc4aaf63800d1cc94bf, type: 2}
  dailyHints:
  - "\u0E25\u0E2D\u0E07\u0E1A\u0E17\u0E2A\u0E32\u0E23\u0E20\u0E32\u0E1E\u0E23\u0E31\u0E01
    \u0E41\u0E25\u0E49\u0E27\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E1A\u0E31\u0E1A\u0E40\u0E1A\u0E34\u0E25\u0E02\u0E2D\u0E07\u0E04\u0E19\u0E17\u0E35\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E23\u0E39\u0E49\u0E08\u0E31\u0E01\u0E15\u0E48\u0E2D
    \xB7 1 \u0E0A\u0E48\u0E27\u0E07 \u0E44\u0E21\u0E48\u0E25\u0E47\u0E2D\u0E01\u0E40\u0E2A\u0E49\u0E19\u0E17\u0E32\u0E07\u0E23\u0E31\u0E01"
  - "\u0E04\u0E19\u0E17\u0E35\u0E48\u0E04\u0E38\u0E13\u0E43\u0E0A\u0E49\u0E40\u0E27\u0E25\u0E32\u0E14\u0E49\u0E27\u0E22\u0E21\u0E35\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E01\u0E25\u0E31\u0E1A\u0E21\u0E32\u0E04\u0E38\u0E22
    \xB7 \u0E40\u0E25\u0E37\u0E2D\u0E01\u0E19\u0E31\u0E14\u0E0A\u0E48\u0E27\u0E07\u0E1A\u0E48\u0E32\u0E22\u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E22\u0E47\u0E19\u0E44\u0E14\u0E49"
  - "\u0E17\u0E35\u0E21\u0E21\u0E35\u0E09\u0E32\u0E01\u0E17\u0E35\u0E48\u0E41\u0E01\u0E49\u0E41\u0E25\u0E49\u0E27\u0E43\u0E2B\u0E49\u0E14\u0E39
    \xB7 \u0E16\u0E49\u0E32\u0E23\u0E31\u0E1A\u0E19\u0E31\u0E14\u0E44\u0E27\u0E49
    \u0E01\u0E14\u0E1A\u0E31\u0E1A\u0E40\u0E1A\u0E34\u0E25\u0E0A\u0E48\u0E27\u0E07\u0E17\u0E35\u0E48\u0E19\u0E31\u0E14\u0E01\u0E31\u0E19
    \xB7 1 \u0E0A\u0E48\u0E27\u0E07"
  - "\u0E19\u0E31\u0E14\u0E0A\u0E48\u0E27\u0E07\u0E1A\u0E48\u0E32\u0E22\u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E22\u0E47\u0E19\u0E22\u0E31\u0E07\u0E21\u0E35\u0E16\u0E36\u0E07\u0E27\u0E31\u0E19\u0E17\u0E35\u0E48
    7 \xB7 \u0E01\u0E14\u0E15\u0E31\u0E27\u0E25\u0E30\u0E04\u0E23\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E14\u0E39\u0E04\u0E33\u0E40\u0E15\u0E37\u0E2D\u0E19\u0E19\u0E31\u0E14"
  - "\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E23\u0E31\u0E1A\u0E19\u0E31\u0E14\u0E01\u0E47\u0E01\u0E25\u0E31\u0E1A\u0E44\u0E1B\u0E0A\u0E27\u0E19\u0E43\u0E2B\u0E21\u0E48\u0E44\u0E14\u0E49\u0E16\u0E36\u0E07\u0E27\u0E31\u0E19\u0E17\u0E35\u0E48
    6 \xB7 \u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E04\u0E38\u0E22\u0E04\u0E23\u0E1A\u0E17\u0E38\u0E01\u0E04\u0E19"
  - "\u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E22\u0E31\u0E07\u0E01\u0E25\u0E31\u0E1A\u0E44\u0E1B\u0E15\u0E01\u0E25\u0E07\u0E19\u0E31\u0E14\u0E44\u0E14\u0E49
    \xB7 \u0E19\u0E31\u0E14\u0E40\u0E14\u0E34\u0E21\u0E22\u0E31\u0E07\u0E40\u0E25\u0E48\u0E19\u0E44\u0E14\u0E49\u0E16\u0E36\u0E07\u0E27\u0E31\u0E19\u0E17\u0E35\u0E48
    7"
  - "\u0E27\u0E31\u0E19\u0E2A\u0E38\u0E14\u0E17\u0E49\u0E32\u0E22\u0E02\u0E2D\u0E07\u0E19\u0E31\u0E14\u0E41\u0E23\u0E01
    \xB7 \u0E16\u0E49\u0E32\u0E04\u0E25\u0E32\u0E14\u0E01\u0E31\u0E19 \u0E22\u0E31\u0E07\u0E21\u0E35\u0E42\u0E2D\u0E01\u0E32\u0E2A\u0E01\u0E25\u0E31\u0E1A\u0E21\u0E32\u0E04\u0E38\u0E22\u0E27\u0E31\u0E19\u0E17\u0E35\u0E48
    8\u201310"
  - "\u0E16\u0E49\u0E32\u0E04\u0E25\u0E32\u0E14\u0E19\u0E31\u0E14\u0E41\u0E23\u0E01
    \u0E25\u0E2D\u0E07\u0E01\u0E25\u0E31\u0E1A\u0E44\u0E1B\u0E2B\u0E32\u0E04\u0E19\u0E19\u0E31\u0E49\u0E19
    \xB7 \u0E40\u0E25\u0E48\u0E19\u0E15\u0E48\u0E2D\u0E01\u0E31\u0E1A\u0E04\u0E19\u0E17\u0E35\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E23\u0E39\u0E49\u0E08\u0E31\u0E01\u0E44\u0E14\u0E49\u0E15\u0E32\u0E21\u0E2A\u0E1A\u0E32\u0E22"
  - "\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E04\u0E19\u0E17\u0E35\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E43\u0E0A\u0E49\u0E40\u0E27\u0E25\u0E32\u0E14\u0E49\u0E27\u0E22
    \xB7 \u0E04\u0E38\u0E22 \u0E17\u0E33\u0E07\u0E32\u0E19\u0E14\u0E49\u0E27\u0E22\u0E01\u0E31\u0E19
    \u0E2B\u0E23\u0E37\u0E2D\u0E43\u0E2B\u0E49\u0E02\u0E2D\u0E07\u0E02\u0E27\u0E31\u0E0D\u0E44\u0E14\u0E49\u0E15\u0E32\u0E21\u0E1B\u0E01\u0E15\u0E34"
