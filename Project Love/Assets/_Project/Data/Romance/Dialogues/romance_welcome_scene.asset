  - choiceId: opening_advice_listen
    text: "\u0E40\u0E27\u0E49\u0E19\u0E43\u0E2B\u0E49\u0E04\u0E19\u0E1F\u0E31\u0E07\u0E44\u0E14\u0E49\u0E15\u0E2D\u0E1A\u0E1A\u0E49\u0E32\u0E07"
    localizedText:
