    context: opening_welcome_wrap · displayName
    sourcePath: Assets/_Project/Data/Romance/Opening/Dialogue/opening_welcome_wrap.asset
    legacy: วันแรก · เลือกคนที่อยากรู้จักต่อ
    thai: วันแรก · เลือกคนที่อยากรู้จักต่อ
    english: ''
